{
  "name": "Attendance Absent Sweep",
  "description": "\u0645\u0633\u062d \u064a\u0648\u0645\u064a \u064a\u0633\u062c\u0644 \u063a\u064a\u0627\u0628 \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u0645\u062c\u062f\u0648\u0644\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u0644\u0645 \u064a\u062d\u0636\u0631\u0648\u0627\u060c \u0645\u0639 \u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0625\u062c\u0627\u0632\u0627\u062a \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 20 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "attendance_absent_sweep",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "mark_absentees": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "supabaseAttendance",
            "args": {
              "action": "markAbsentees"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u063a\u064a\u0627\u0628",
            "description": "\u064a\u0633\u062a\u062b\u0646\u064a \u0627\u0644\u0625\u062c\u0627\u0632\u0627\u062a \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629"
          }
        }
      }
    ]
  }
}