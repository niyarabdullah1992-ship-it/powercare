{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "attendance_absent_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "mark_absentees": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "supabaseAttendance",
            "args": {
              "action": "markAbsentees"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Mark absentees",
            "description": "No check-in today"
          }
        }
      }
    ]
  },
  "description": "Daily sweep that marks any employee who never checked in that day as absent.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 20 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Attendance Absent Sweep"
}