{
  "name": "Task Escalation Sweep",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "task_escalation_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_sweep": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "operations",
            "args": {
              "action": "runEscalationSweep"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0641\u062d\u0635 \u0627\u0644\u062a\u0635\u0639\u064a\u062f",
            "description": "\u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u062a\u0623\u062e\u0631\u0629 \u0648\u0627\u0644\u062a\u0635\u0639\u064a\u062f"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 20 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Runs hourly to mark overdue task targets and send repeat escalation notifications to managers, without needing anyone to have the app open."
}