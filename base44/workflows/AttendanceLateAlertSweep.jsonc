{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "attendance_late_alert_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_late_employees": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "supabaseAttendance",
            "args": {
              "action": "checkLateAlerts"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0641\u062d\u0635 \u0627\u0644\u0645\u062a\u0623\u062e\u0631\u064a\u0646",
            "description": "\u062a\u0646\u0628\u064a\u0647 \u0641\u0648\u0631\u064a \u0644\u0644\u0645\u062f\u064a\u0631"
          }
        }
      }
    ]
  },
  "description": "Every 5 minutes, checks for employees who passed the allowed check-in time by more than the late threshold and instantly notifies their manager.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Attendance Late Alert Sweep"
}