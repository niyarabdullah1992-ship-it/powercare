{
  "name": "Trial Reminder Sweep",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "trial_reminder_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_trial_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "subscriberEmails",
            "args": {
              "action": "trialReminderSweep"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0625\u0631\u0633\u0627\u0644 \u062a\u0646\u0628\u064a\u0647\u0627\u062a \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u062a\u062c\u0631\u0628\u0629",
            "description": "\u0642\u0628\u0644 3 \u0623\u064a\u0627\u0645 \u0645\u0646 \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u062a\u062c\u0631\u0628\u0629"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Asia/Riyadh",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily sweep that emails paid subscribers a reminder 3 days before their 4-month free trial ends."
}