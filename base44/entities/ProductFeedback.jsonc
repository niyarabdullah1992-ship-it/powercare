{
  "name": "ProductFeedback",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "message": {
      "type": "string"
    },
    "page": {
      "type": "string"
    }
  },
  "required": [
    "companyId",
    "rating"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}