{
  "name": "SignatureRequest",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "The PowerCare company (tenant) this request belongs to."
    },
    "creatorId": {
      "type": "string",
      "description": "Employee/owner id of the person who created the request."
    },
    "creatorName": {
      "type": "string"
    },
    "creatorEmail": {
      "type": "string"
    },
    "fileName": {
      "type": "string"
    },
    "docUrl": {
      "type": "string",
      "description": "URL of the latest document version."
    },
    "verificationId": {
      "type": "string",
      "description": "Verification ID stamped after all parties sign."
    },
    "finalHash": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 of the fully-signed final file."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed"
      ]
    },
    "expiresAt": {
      "type": "string",
      "description": "Signing links expire after this ISO timestamp."
    },
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Ordered signing parties and their statuses."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "creatorId",
    "fileName",
    "docUrl",
    "status",
    "signers"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}