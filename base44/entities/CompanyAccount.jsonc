{
  "name": "CompanyAccount",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string",
      "description": "Stable client-side company id (matches the registry entry used across the app)."
    },
    "name": {
      "type": "string"
    },
    "ownerEmail": {
      "type": "string"
    },
    "ownerPassword": {
      "type": "string",
      "description": "Server-only PBKDF2 password hash. Plaintext passwords are never stored."
    },
    "plan": {
      "type": "string"
    },
    "allowedEmailDomain": {
      "type": "string"
    },
    "trialReminderSent": {
      "type": "boolean",
      "default": false,
      "description": "True once the trial-ending reminder email has been sent for this account."
    }
  },
  "required": [
    "companyId",
    "ownerEmail",
    "ownerPassword"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}