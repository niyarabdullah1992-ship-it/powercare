{
  "name": "Station",
  "type": "object",
  "properties": {
    "stationId": {
      "type": "string",
      "description": "Stable client-side id used across the app (employees, tasks, HR all reference this value)."
    },
    "companyId": {
      "type": "string",
      "description": "The PowerCare company (tenant) this station belongs to."
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "managerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "lat": {
      "type": [
        "number",
        "null"
      ],
      "description": "Workplace GPS latitude used to verify check-ins."
    },
    "lng": {
      "type": [
        "number",
        "null"
      ],
      "description": "Workplace GPS longitude used to verify check-ins."
    },
    "radiusMeters": {
      "type": [
        "number",
        "null"
      ],
      "description": "Allowed check-in radius around the workplace location, in meters."
    }
  },
  "required": [
    "stationId",
    "companyId",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}