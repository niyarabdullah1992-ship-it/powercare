{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "itemId": {
      "type": "string"
    },
    "movementType": {
      "type": "string",
      "enum": [
        "receive",
        "purchase",
        "issue",
        "return",
        "transfer"
      ]
    },
    "quantity": {
      "type": "number",
      "minimum": 0
    },
    "fromLocationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "toLocationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "employeeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "performedBy": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "workReference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Task or project for which stock was issued."
    },
    "workDate": {
      "type": [
        "string",
        "null"
      ],
      "description": "Date the material was issued to station work."
    },
    "balanceBefore": {
      "type": [
        "number",
        "null"
      ]
    },
    "balanceAfter": {
      "type": [
        "number",
        "null"
      ]
    },
    "sourceBalanceBefore": {
      "type": [
        "number",
        "null"
      ]
    },
    "sourceBalanceAfter": {
      "type": [
        "number",
        "null"
      ]
    },
    "destinationBalanceBefore": {
      "type": [
        "number",
        "null"
      ]
    },
    "destinationBalanceAfter": {
      "type": [
        "number",
        "null"
      ]
    },
    "purchasePrice": {
      "type": [
        "number",
        "null"
      ],
      "description": "Optional unit price recorded for a direct station purchase."
    },
    "unitPrice": {
      "type": [
        "number",
        "null"
      ]
    },
    "totalCost": {
      "type": [
        "number",
        "null"
      ]
    },
    "supplierName": {
      "type": [
        "string",
        "null"
      ]
    },
    "purchaseDate": {
      "type": [
        "string",
        "null"
      ],
      "description": "Purchase timestamp in ISO format."
    }
  },
  "required": [
    "companyId",
    "itemId",
    "movementType",
    "quantity",
    "performedBy"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}