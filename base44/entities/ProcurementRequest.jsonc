{
  "name": "ProcurementRequest",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "requestNumber": {
      "type": "string"
    },
    "stationId": {
      "type": "string"
    },
    "requesterId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requesterName": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "justification": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "ordered",
        "received"
      ]
    },
    "reviewedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "companyId",
    "requestNumber",
    "stationId",
    "items",
    "justification",
    "status"
  ]
}