{
  "name": "Employee",
  "type": "object",
  "properties": {
    "employeeId": {
      "type": "string",
      "description": "Stable client-side id used across the app."
    },
    "companyId": {
      "type": "string",
      "description": "The PowerCare company this employee belongs to."
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "stationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "phone": {
      "type": "string"
    },
    "position": {
      "type": [
        "string",
        "null"
      ]
    },
    "anonymousId": {
      "type": "string"
    },
    "points": {
      "type": "number",
      "default": 0
    },
    "hrLevelId": {
      "type": [
        "string",
        "null"
      ]
    },
    "hrStationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "hrClusterId": {
      "type": [
        "string",
        "null"
      ]
    },
    "canManageTeam": {
      "type": "boolean",
      "default": false
    },
    "managedStations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "gradeId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Reference to the company job grade."
        },
        "maxStations": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "description": "Maximum stations; null means unlimited."
        },
        "position": {
          "type": [
            "string",
            "null"
          ],
          "description": "Employee-managed free-form position title."
        },
        "department": {
          "type": [
            "string",
            "null"
          ]
        },
        "hireDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "jobNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "contractType": {
          "type": [
            "string",
            "null"
          ]
        },
        "nationalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "birthDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "nationality": {
          "type": [
            "string",
            "null"
          ]
        },
        "maritalStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependents": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "qualification": {
          "type": [
            "string",
            "null"
          ]
        },
        "emergencyName": {
          "type": [
            "string",
            "null"
          ]
        },
        "emergencyPhone": {
          "type": [
            "string",
            "null"
          ]
        },
        "gosiNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "medicalInsurance": {
          "type": [
            "string",
            "null"
          ]
        },
        "iban": {
          "type": [
            "string",
            "null"
          ]
        },
        "satisfactionScore": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "baseSalary": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "allowances": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatarUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "bannerUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "salaryCertificateUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "salaryCertificateName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "leaveRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "hrMessages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "employeeId",
    "companyId",
    "name",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}