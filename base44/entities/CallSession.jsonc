{
  "name": "CallSession",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "roomId": {
      "type": "string"
    },
    "chatType": {
      "type": "string",
      "enum": [
        "general",
        "dm"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "audio",
        "video"
      ]
    },
    "initiatorId": {
      "type": "string"
    },
    "initiatorName": {
      "type": "string"
    },
    "participantIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "ended"
      ],
      "default": "active"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "startedAt": {
      "type": "string"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "companyId",
    "roomId",
    "chatType",
    "mode",
    "initiatorId",
    "participantIds",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}