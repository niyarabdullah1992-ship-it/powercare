{
  "name": "AnonymousReportReceipt",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "reportId": {
      "type": "string"
    },
    "employeeId": {
      "type": "string",
      "description": "Private server-side link used only to let the sender follow their own anonymous report."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "companyId",
    "reportId",
    "employeeId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": false,
    "update": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}